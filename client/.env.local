NEXT_PUBLIC_API_URL=http://localhost:5003/api

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here

# ── Launch Gate ─────────────────────────────────────────────────────────
# Set to "private"  →  only invited users (via ?ref=ACCESS_KEY) can access
# Set to "public"   →  site is fully open (flip this when you go live)
NEXT_PUBLIC_LAUNCH_MODE=private

# Secret key — share this in your invite link: yoursite.com?ref=crewup2026launch
NEXT_PUBLIC_ACCESS_KEY=crewup2026launch
